# Copy to .env.production on the server only. Keep this file out of Git.
# Generate each secret separately: openssl rand -hex 32
# Use a hex POSTGRES_PASSWORD so it can safely appear in the connection URL.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://yozaver.uz
CORS_ORIGINS=https://www.yozaver.uz
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yozaver.uz/auth/google/callback
ADMIN_EMAILS=
