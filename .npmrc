# @nestjs/throttler@6.5.0 (its latest release) still declares a peer range that
# stops at @nestjs/common@11, while this project runs NestJS 12. The package
# works correctly at runtime, so installs must not fail the peer check —
# npm 10 (Ubuntu server) enforces it while npm 11 (dev machines) does not.
legacy-peer-deps=true
